<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Scalpel</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Lint: the compiler's own analyzers at the recommended level, the code style in .editorconfig and Roslynator,
         all as errors, so `dotnet build` is the lint check. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTestProject Condition="!$(Configuration.StartsWith('Export'))">true</IsTestProject>
    <!-- Methods with loops are compiled optimized right away instead of starting unoptimized: the loading screen's
         warm-up then compiles them for good. Otherwise a long loop running unoptimized is compiled again on the main
         thread, mid-frame, each time it gets hot (on-stack replacement): 10-70 ms stalls cutting and pulling skin. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
  </PropertyGroup>

  <!-- Tests build Debug: optimized, so the frame budget times the code an exported game runs, not code compiled for
       stepping through in a debugger. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="4.14.1" PrivateAssets="all" />
  </ItemGroup>

  <!-- The tests and the test framework stay out of exported games, debug exports included. -->
  <ItemGroup Condition="$(Configuration.StartsWith('Export'))">
    <Compile Remove="tests/**" />
    <!-- Written by the GdUnit4 test adapter when tests run; it needs the test framework. -->
    <Compile Remove="gdunit4_testadapter_v5/**" />
  </ItemGroup>
  <ItemGroup Condition="!$(Configuration.StartsWith('Export'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="gdUnit4.api" Version="5.0.0" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.0.0" />
    <PackageReference Include="gdUnit4.analyzers" Version="1.0.0" PrivateAssets="all" />
    <PackageReference Include="JunitXml.TestLogger" Version="8.0.0" />
  </ItemGroup>
</Project>
