<?xml version="1.0" encoding="utf-8"?>
<!-- Defaults for running the tests from an IDE (Rider, VS Code). build.py test writes its own per test suite. -->
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <GODOT_BIN>.tools/Godot_v4.7.2-stable_mono_linux_x86_64/Godot_v4.7.2-stable_mono_linux.x86_64</GODOT_BIN>
    </EnvironmentVariables>
    <TestCaseFilter>TestCategory!=broken</TestCaseFilter>
  </RunConfiguration>
  <GdUnit4>
    <Parameters>--headless</Parameters>
    <CaptureStdOut>true</CaptureStdOut>
    <CompileProcessTimeout>120000</CompileProcessTimeout>
  </GdUnit4>
</RunSettings>
