; Engine configuration file.
; Input actions are registered from code (src/Core/InputActions.cs) so defaults and rebinding live in one place.

config_version=5

[application]

config/name="This Scalpel Is Mine"
config/description="Co-op roguelike surgery thriller."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://assets/icons/app_icon.svg"

[autoload]

Settings="*res://src/Core/Settings.cs"
Net="*res://src/Core/Net.cs"
Sfx="*res://src/Core/Sfx.cs"

[dotnet]

project/assembly_name="ThisScalpelIsMine"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="patient"
3d_physics/layer_3="site"
3d_physics/layer_4="tools"
3d_physics/layer_5="surgeons"
3d_physics/layer_6="cavity"
3d_physics/layer_7="interactables"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/penetration_slop=0.002

[rendering]

anti_aliasing/quality/msaa_3d=2
